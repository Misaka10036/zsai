{
    "id": 49,
    "title": {
        "en": "Seafile weekly report",
        "de": "Seafile-Wochenbericht",
        "zh": "Seafile 日报汇总周报"
    },
    "description": {
        "en": "Fetch this week daily reports from Seafile, synthesize a structured weekly report, and write it into the weekly-report dataset. Use the existing agent scheduler.",
        "de": "Holt die Tagesberichte der Woche aus Seafile, erstellt einen strukturierten Wochenbericht und schreibt ihn in den Wochenbericht-Datensatz.",
        "zh": "从 Seafile 拉取本周日报，综合成周报并写入周报资料库。用已有的智能体定时任务按周运行。"
    },
    "canvas_type": "Recommended",
    "canvas_types": [
        "Recommended",
        "Agent"
    ],
